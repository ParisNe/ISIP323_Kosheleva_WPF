<Window x:Class="ISIP323_Kosheleva_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP323_Kosheleva_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.33*"/>
            <ColumnDefinition Width="0.33*"/>
            <ColumnDefinition Width="0.33*"/>
        </Grid.ColumnDefinitions>
        
            <Button Grid.Column="0" x:Name="BackButton" Content="Назад" Click="BackButton_OnClick" Height="45" Width="120" Background="#FFC6B61F" Foreground="White"/>
            <ProgressBar Grid.Column="1" Foreground="#FF505050" Height="55" Width="250" Background="#FFFDFF7C" Maximum="100" Minimum="0" />
            <TextBlock Grid.Column="2" x:Name="Sum"  Text="Итог:" Margin="20" FontSize="20"/>

        <Frame Grid.ColumnSpan="3" x:Name="MainFrame" Grid.Row="1" Source="Pages/Step1.xaml" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>
    </Grid>
</Window>
