<Page x:Class="ISIP323_Kosheleva_WPF.Pages.Step5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Step5" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Ваши данные:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="ФИО:"/>
                <TextBox x:Name="NameBox" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Телефон:"/>
                <TextBox x:Name="PhoneBox" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Email:"/>
                <TextBox x:Name="EmailBox" Height="25" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Сводка заказа:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Модель:" FontWeight="Bold"/>
                <TextBlock x:Name="SumModel" Margin="0,0,0,5"/>

                <TextBlock Text="Стоимость:" FontWeight="Bold"/>
                <TextBlock x:Name="SumPrice" Foreground="Green" Margin="0,0,0,10"/>

                <TextBlock Text="Ежемесячный платеж:" FontWeight="Bold"/>
                <TextBlock x:Name="SumPayment" Foreground="Red"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#F0F0F0" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="SubmitButton" Content="Отправить" Width="100" Height="30" Background="#0078D4" Foreground="White" VerticalAlignment="Bottom" Click="SubmitButton_Click" IsEnabled="False"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>