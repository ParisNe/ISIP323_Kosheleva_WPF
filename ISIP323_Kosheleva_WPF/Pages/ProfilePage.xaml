<Window x:Class="ISIP323_Kosheleva_WPF.Pages.ProfilePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP323_Kosheleva_WPF.Pages"
        mc:Ignorable="d"
        Title="ProfilePage" Height="450" Width="800">
        <StackPanel Margin="10">
            <Button Content="Назад" Click="Back_Click"
            HorizontalAlignment="Left" FontSize="20"
            Margin="5" Height="40" Width="100"/>
            <TextBlock Text="Личный кабинет" FontSize="20" Margin="10"/>

                <StackPanel>
                    <TextBlock Text="Информация об аккаунте:" FontSize="20" Margin="5"/>
                    <TextBlock x:Name="UsernameText" Margin="0,2"/>
                    <TextBlock x:Name="EmailText" Margin="0,2"/>
                    <TextBlock x:Name="FullNameText" Margin="0,2"/>
                    <TextBlock x:Name="RegDateText" Margin="0,2"/>
                </StackPanel>

            <TextBlock Text="Мои билеты:" FontSize="20" Margin="5"/>

            <ListBox x:Name="BookingsList" Margin="5" HorizontalAlignment="Left" Height="Auto" Width="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                <TextBlock Text="Дата: " Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SessionDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                                <TextBlock Text="Время: " Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SessionTime}"/>
                                <TextBlock Text="Зал: " Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding HallName}"/>
                                <TextBlock Text="Ряд: " Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SeatRow}"/>
                                <TextBlock Text="Место: " Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SeatNumber}"/>
                                <TextBlock Text="Цена: " Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Price}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
</Window>
