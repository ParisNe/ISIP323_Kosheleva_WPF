<Window x:Class="ISIP323_Kosheleva_WPF.Pages.BookingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP323_Kosheleva_WPF.Pages"
        mc:Ignorable="d"
        Title="BookingPage" Height="450" Width="800">
    <StackPanel>
        <TextBlock Text="Оформление билета:" FontSize="22"  Margin="5"/>

            <StackPanel>
                <TextBlock x:Name="MovieText" Margin="2"/>
                <TextBlock x:Name="HallText" Margin="2"/>
                <TextBlock x:Name="DateTimeText" Margin="2"/>
                <TextBlock x:Name="SeatText" Margin="2"/>
                <TextBlock x:Name="PriceText" Margin="2" FontWeight="Bold"/>
            </StackPanel>

        <Button Content="Подтвердить бронирование" HorizontalAlignment="Left"
                Height="42" Width="Auto" FontSize="20"
                Click="ConfirmBooking_Click" Margin="7" />
        
        <Button Content="Отмена" Margin="7"
                Height="35" Width="200" FontSize="20"
                HorizontalAlignment="Left" Click="Cancel_Click"/>
    </StackPanel>
</Window>