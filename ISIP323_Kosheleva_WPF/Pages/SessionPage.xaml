<Window x:Class="ISIP323_Kosheleva_WPF.Pages.SessionPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP323_Kosheleva_WPF.Pages"
        mc:Ignorable="d"
        Title="SessionPage" Height="450" Width="800">
    <ScrollViewer>
        <StackPanel Margin="10">
            <Button Content="Back" Height="30" Width="55" FontSize="20" Click="Back_Click" HorizontalAlignment="Left"/>

            <TextBlock x:Name="SessionInfo" FontSize="16" FontWeight="Bold" Margin="5"/>

            <Button Content="Очистить все занятые места" Click="ClearAllBookedSeats_Click" Margin="5" Padding="5" />

            <ListBox x:Name="SeatsGrid" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" Width="50" Height="50" Margin="2">
                            <Button Content="{Binding SeatNumber}" 
                                    Click="SelectSeat_Click"
                                    Tag="{Binding SeatID}"
                                    Background="{Binding IsAvailable, Converter={StaticResource BoolToColorConverter}}"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="SelectedSeatText" Margin="5"/>
            <Button x:Name="BookButton" Content="Оформить билет" Click="BookTicket_Click" Margin="5" Padding="5" IsEnabled="False"/>
        </StackPanel>
    </ScrollViewer>
</Window>
