<Window x:Class="ISIP323_Kosheleva_WPF.Pages.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP323_Kosheleva_WPF.Pages"
        mc:Ignorable="d"
        Title="LoginPage" Height="450" Width="800">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Margin="10">
        <Button Content="← Назад" Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>

        <TextBlock Text="Вход" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

        <TextBlock Text="Логин:" Margin="5"/>
        <TextBox x:Name="LoginBox" Margin="5"/>

        <TextBlock Text="Пароль:" Margin="5"/>
        <PasswordBox x:Name="PasswordBox" Margin="5"/>

        <Button Content="Войти" Click="Login_Click" Margin="5" Padding="5"/>

        <TextBlock Text="Нет аккаунта?" HorizontalAlignment="Center" Margin="10,20,10,5"/>
        <Button Content="Зарегистрироваться" Click="ToRegisterPage_Click" Margin="5" Padding="5"/>

        <TextBlock x:Name="MessageText" Foreground="Red" TextWrapping="Wrap" Margin="5"/>
    </StackPanel>
</Window>
