<Page x:Class="ISIP323_Kosheleva_WPF.Pages.Step2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Step2" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Цвета -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Выберите цвет:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <RadioButton x:Name="PinckColor" GroupName="ColorGroup" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Гламурно Розовый (+100к)" VerticalAlignment="Center"/>
                        <Border Width="20" Height="20" Margin="10,0,0,0" BorderBrush="Black" BorderThickness="1" Background="#FFE987D2"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="BlueColor" GroupName="ColorGroup" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Нежно голубой (+20k)" VerticalAlignment="Center"/>
                        <Border Width="20" Height="20" Margin="10,0,0,0" BorderBrush="Black" BorderThickness="1" Background="LightBlue"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="BlackColor" GroupName="ColorGroup" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Черный (+15k)" VerticalAlignment="Center"/>
                        <Border Width="20" Height="20" Margin="10,0,0,0" BorderBrush="Black" BorderThickness="1" Background="Black"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="WhiteColor" GroupName="ColorGroup" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Белый (+10k)" VerticalAlignment="Center"/>
                        <Border Width="20" Height="20" Margin="10,0,0,0" BorderBrush="Black" BorderThickness="1" Background="White"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SilverColor" GroupName="ColorGroup" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Серебристый (+25k)" VerticalAlignment="Center"/>
                        <Border Width="20" Height="20" Margin="10,0,0,0" BorderBrush="Black" BorderThickness="1" Background="Silver"/>
                    </StackPanel>
                </RadioButton>
                
            </StackPanel>

            <!-- Доп чота -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Дополнительные опции:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <CheckBox x:Name="Option1" Content="Кожаный салон (+150к)" Margin="5"/>
                <CheckBox x:Name="Option2" Content="Панорамная крыша (+200к)" Margin="5"/>
                <CheckBox x:Name="Option3" Content="Подогрев сидений (+50к)" Margin="5"/>
                <CheckBox x:Name="Option4" Content="Чот (+75к)" Margin="5"/>
                <CheckBox x:Name="Option5" Content="Что-то еще (+40к)" Margin="5"/>
                <CheckBox x:Name="Option6" Content="Камера заднего вида (+30к)" Margin="5"/>
                <CheckBox x:Name="Option7" Content="Чот крутое (+100к)" Margin="5"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="NextButton" Content="Далее" Width="200" Height="45" Margin="5" Background="Green" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>